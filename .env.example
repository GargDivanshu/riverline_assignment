# Copy this file to .env and fill in the values marked below, then run:
#   docker compose up --build
# See the README's "Environment variables" table for the full explanation
# of every variable, what it's used for, and where to get each API key.

# Browser origin and auth base URL. Leave as-is for local use.
APP_ORIGIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Local Postgres connection and credentials. Compose overrides the host to
# "db" internally; this value is only used outside Docker. The
# POSTGRES_* values are local-only defaults, not real secrets.
DATABASE_URL=postgresql://riverline:local-development-only@localhost:15432/riverline
POSTGRES_USER=riverline
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=riverline

# Required random values (32+ characters each). Generate both at once with
# `npm run setup` (writes into your ignored .env, never printed to the
# terminal), or fill them in yourself with e.g. `openssl rand -hex 32`.
BETTER_AUTH_SECRET=
INTERNAL_API_SECRET=

# Where the web app reaches the Python agent. Compose overrides this to
# http://agent:8000 internally; this value is only used outside Docker.
AGENT_API_URL=http://localhost:8000

# Optional: both values are required together to show Google sign-in.
# Create a Web application OAuth client at https://console.cloud.google.com/
# and register http://localhost:3000/api/auth/callback/google as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required to start a live conversation at all — creates a private,
# short-lived Daily room and participant tokens for each call.
# Get one at https://dashboard.daily.co/
DAILY_API_KEY=

# Which voice engine runs: "realtime" (OpenAI speech-to-speech, needs OPENAI_API_KEY)
# or "cascade" (STT -> LLM -> TTS, needs ELEVENLABS_API_KEY + OPENROUTER_API_KEY).
# They share every tool, prompt, and tracing concern; this is the only switch.
VOICE_ENGINE=realtime

# Required when VOICE_ENGINE=realtime. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime-2.1-mini
REALTIME_VOICE=alloy

# Required when VOICE_ENGINE=cascade.
# ElevenLabs (streaming speech recognition + synthesis): https://elevenlabs.io/app/settings/api-keys
# OpenRouter (the conversational model for this path): https://openrouter.ai/keys
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
OPENROUTER_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
STT_MODEL=scribe_v2_realtime
TTS_MODEL=eleven_flash_v2_5
# Model used for spoken turns and tool calls. Luna's function-calling proved unreliable
# in live testing (malformed tool-call JSON, unrecovered stalls); Terra trades some
# latency for correctness.
VOICE_MODEL=openai/gpt-5.6-terra

# Optional: local concurrency cap and maximum call length in seconds.
# Defaults are sensible for local evaluation.
VOICE_MAX_SESSIONS=2
VOICE_MAX_SECONDS=900

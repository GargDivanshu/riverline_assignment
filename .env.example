# Local origin and database. Compose replaces the database host with db.
APP_ORIGIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=postgresql://riverline:local-development-only@localhost:15432/riverline
POSTGRES_USER=riverline
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=riverline

# Required random values. npm run setup creates these in your ignored .env.
BETTER_AUTH_SECRET=
INTERNAL_API_SECRET=

# Internal URL. Compose replaces the host with agent.
AGENT_API_URL=http://localhost:8000

# Optional: both values are required to show Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Reserved for the next live-voice milestone; no paid calls in this scaffold.
DAILY_API_KEY=

# Available provider options for the proposed voice pipeline; adapters are pending.
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

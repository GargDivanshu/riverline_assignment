# Local origin and database. Compose replaces the database host with db.
APP_ORIGIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=postgresql://riverline:local-development-only@localhost:15432/riverline
POSTGRES_USER=riverline
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=riverline

# Required random values. npm run setup creates these in your ignored .env.
BETTER_AUTH_SECRET=
INTERNAL_API_SECRET=

# Internal URL. Compose replaces the host with agent.
AGENT_API_URL=http://localhost:8000

# Optional: both values are required to show Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required to start a live conversation.
DAILY_API_KEY=

# Which voice engine runs: "realtime" (OpenAI speech-to-speech, needs OPENAI_API_KEY)
# or "cascade" (STT -> LLM -> TTS, needs ELEVENLABS_API_KEY + OPENROUTER_API_KEY).
# They share every tool, prompt, and tracing concern; this is the only switch.
VOICE_ENGINE=realtime

# Required when VOICE_ENGINE=realtime.
OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime-2.1-mini
REALTIME_VOICE=alloy

# Required when VOICE_ENGINE=cascade.
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
OPENROUTER_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
STT_MODEL=scribe_v2_realtime
TTS_MODEL=eleven_flash_v2_5
# Model used for spoken turns and tool calls. Luna's function-calling proved unreliable
# in live testing (malformed tool-call JSON, unrecovered stalls); Terra trades some
# latency for correctness.
VOICE_MODEL=openai/gpt-5.6-terra

VOICE_MAX_SESSIONS=2
VOICE_MAX_SECONDS=900
